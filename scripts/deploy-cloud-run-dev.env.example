# Copy this file to .env.deploy.dev, fill in overrides if needed, then run:
#   ./scripts/deploy-cloud-run-dev.sh
#
# Keep the copied .env.deploy.dev file untracked.
# Terraform owns the Cloud Run service shape and runtime environment.

export PROJECT_ID="${PROJECT_ID:-declip-v2-dev}"
export REGION="${REGION:-us-central1}"
export REPOSITORY="${REPOSITORY:-declip-dev}"
export SERVICE="${SERVICE:-declip-inference-dev}"
export IMAGE_TAG="${IMAGE_TAG:-dev}"
