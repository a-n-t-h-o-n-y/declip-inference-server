# Copy this file to .env.deploy.dev, fill in overrides if needed, then run:
#   ./scripts/deploy-cloud-run-dev.sh
#
# Keep the copied .env.deploy.dev file untracked.

export PROJECT_ID="${PROJECT_ID:-declip-v2-dev}"
export REGION="${REGION:-us-central1}"
export REPOSITORY="${REPOSITORY:-declip-dev}"
export SERVICE="${SERVICE:-declip-inference-dev}"
export IMAGE_TAG="${IMAGE_TAG:-dev}"

export APP_ENV="${APP_ENV:-dev}"
export APP_RUNTIME_MODE="${APP_RUNTIME_MODE:-cloud}"
export APP_NAME="${APP_NAME:-declip-inference-server}"
export APP_VERSION="${APP_VERSION:-0.1.0}"
export LOG_LEVEL="${LOG_LEVEL:-INFO}"

export GCP_PROJECT_ID="${GCP_PROJECT_ID:-declip-v2-dev}"
export FIRESTORE_DATABASE="${FIRESTORE_DATABASE:-(default)}"
export GCS_BUCKET_NAME="${GCS_BUCKET_NAME:-anthonymleedom-declip-v2-dev-audio}"

export CLOUD_TASKS_CONVERSION_QUEUE="${CLOUD_TASKS_CONVERSION_QUEUE:-declip-audio-conversion-dev}"
export CLOUD_TASKS_LOCATION="${CLOUD_TASKS_LOCATION:-us-central1}"
export CLOUD_TASKS_SERVICE_ACCOUNT="${CLOUD_TASKS_SERVICE_ACCOUNT:-declip-tasks-dev@declip-v2-dev.iam.gserviceaccount.com}"

export CONVERSION_SERVICE_URL="${CONVERSION_SERVICE_URL:-https://declip-audio-conversion-dev-xbigznypoq-uc.a.run.app}"
export CONVERSION_SERVICE_AUDIENCE="${CONVERSION_SERVICE_AUDIENCE:-https://declip-audio-conversion-dev-xbigznypoq-uc.a.run.app}"
export PUBLIC_API_SERVICE_ACCOUNT="${PUBLIC_API_SERVICE_ACCOUNT:-declip-api-dev@declip-v2-dev.iam.gserviceaccount.com}"
export INFERENCE_SERVICE_ACCOUNT="${INFERENCE_SERVICE_ACCOUNT:-declip-inference-dev@declip-v2-dev.iam.gserviceaccount.com}"

# The script discovers this service URL on redeploy when omitted.
export INFERENCE_SERVICE_AUDIENCE="${INFERENCE_SERVICE_AUDIENCE:-}"

export MODEL_CONFIG_PATH="${MODEL_CONFIG_PATH:-config/models.yaml}"
export APP_CONFIG_PATH="${APP_CONFIG_PATH:-config/app.yaml}"
export MODEL_ARTIFACT_CACHE_DIR="${MODEL_ARTIFACT_CACHE_DIR:-/tmp/declip-models}"
export INFERENCE_DEVICE="${INFERENCE_DEVICE:-cpu}"
export INFERENCE_BACKEND="${INFERENCE_BACKEND:-passthrough}"
export MAX_DECODED_DURATION_SECONDS="${MAX_DECODED_DURATION_SECONDS:-1200}"

export CLOUD_RUN_CPU="${CLOUD_RUN_CPU:-2}"
export CLOUD_RUN_MEMORY="${CLOUD_RUN_MEMORY:-4Gi}"
export CLOUD_RUN_TIMEOUT="${CLOUD_RUN_TIMEOUT:-3600}"
export CLOUD_RUN_CONCURRENCY="${CLOUD_RUN_CONCURRENCY:-1}"
